# The temporary profile of the browser that Lighthouse creates. On a machine
# without a usable TMPDIR it lands in the working directory. Only directories
# are ignored, so `scripts/lighthouse.sh` stays tracked.
.lighthouse/
lighthouse/
lighthouse.*/

