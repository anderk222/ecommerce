
# --- Database (owned by compose; the backend reads the equivalent names) ---
POSTGRES_DB=xtrim
POSTGRES_USER=xtrim
POSTGRES_PASSWORD=change_me_local_only
# Host port of PostgreSQL. Inside the Compose network it is always 5432.
POSTGRES_PORT=5432

# --- Backend: datasource ---
# Host port of the API. It stays 8080 unless the machine already has
# something on it: the backend reads the value as the port on the host.
# Inside the container the API always listens on 8080.
SERVER_PORT=8080
# Host development values. The Compose `backend` service overrides the URL
# with postgres:5432 and the Redis host with redis.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/xtrim
SPRING_DATASOURCE_USERNAME=xtrim
SPRING_DATASOURCE_PASSWORD=change_me_local_only

# --- Backend: Redis (Spring Cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend: Kafka (infrastructure only; no use case depends on it) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# --- Backend: security ---
# HS256 signing key — must be at least 32 bytes. Generate a real one with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_replace_with_a_random_secret_of_at_least_32_bytes
JWT_TTL=3600

# --- Backend: CORS (origins allowed to call /api/public) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Frontend ---
# Host port of the site. Inside the Compose container it is always 4000.
WEB_PORT=4200
# Absolute URL of the API. The SSR server uses it; the browser uses the
# relative /api path. The Compose `frontend` service overrides it with the
# internal address http://backend:8080/api.
PUBLIC_API_URL=http://localhost:8080/api
# Public URL of the site. Used for canonical links and Open Graph.
SITE_BASE_URL=http://localhost:4200
# Hostnames allowed to reach the SSR engine — Angular's SSRF protection.
# Comma-separated, without the port. On Render: the public hostname.
NG_ALLOWED_HOSTS=localhost,127.0.0.1
